{
  "name": "booking-89center",
  "account_id": "d2874089eebcda705bf220d39f117aec",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "none", "run_worker_first": true },
  "vars": {
    "ADMIN_EMAILS": "senseco89center@gmail.com,uken.shohei@gmail.com",
