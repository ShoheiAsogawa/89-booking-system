    "BOOKING_ORIGIN": "https://www.89center.dev",
    "SUPABASE_ANON_KEY": "sb_publishable_J5lxwjP27PycJD78Jkgzsw_VhW4ThgJ",
    "SUPABASE_URL": "https://zzezehgnzeneueklxduy.supabase.co"
  },
  "send_email": [{ "name": "ALERT_EMAIL", "destination_address": "uken.shohei@gmail.com" }],
  "d1_databases": [{ "binding": "DB", "database_id": "254bc99a-d597-4b1f-a891-82fa9458fc84", "database_name": "要確認" }],
  "kv_namespaces": [{ "binding": "OCCUPANCY", "id": "2c164f1db1a04340b0c8e72ab9bce448" }]
